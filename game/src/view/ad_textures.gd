class_name AdTextures
extends RefCounted
## LED ad-board texture (generated by tools_py/gen_ads.py; fictional brands).

static var _tex: Texture2D


static func board_texture() -> Texture2D:
	if _tex == null:
		if ResourceLoader.exists("res://assets/gen/ads.png"):
			_tex = load("res://assets/gen/ads.png")
		else:
			var g := GradientTexture2D.new()
			_tex = g
	return _tex
